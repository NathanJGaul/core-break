{
  "name": "core-break",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-config.mjs --local",
    "check:deploy": "node scripts/check-config.mjs",
    "preview": "vite build && wrangler dev",
    "deploy": "npm run check:deploy && vite build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.47",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
